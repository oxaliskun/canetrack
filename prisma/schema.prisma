// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   // FARMER, ADMIN
  isActive       Boolean  @default(true)
  contactNumber    String?
  address          String?
  profilePicture   String?
  emailVerified    Boolean  @default(false)
  verificationCode String?
  verificationStatus String @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedBy         String?
  assignedMill       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  farms           Farm[]                 @relation("FarmerFarms")
  tickets         WeightTicket[]         @relation("FarmerTickets")
  reconciliations ReconciliationRecord[] @relation("AdminReconciliations")
  auditLogs       AuditLog[]             @relation("UserAudits")
  notifications   Notification[]
  verificationDocuments VerificationDocument[]
  trucks              Truck[]
  expenses            Expense[]
}

model VerificationDocument {
  id             String   @id @default(cuid())
  userId         String
  documentType   String   // ID, LAND_TITLE, TAX_DECLARATION, LEASE, CERTIFICATE
  imageUrl       String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  farmId         String?  // null if user-level doc, farm ID if farm doc
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Truck {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  make        String
  model       String
  capacity    Float
  color       String?
  ownerId     String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  owner User @relation(fields: [ownerId], references: [id])
}

model SugarcaneVariant {
  id               String   @id @default(cuid())
  name             String   @unique
  characteristics  String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  pricings Pricing[]
}

model SugarType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  pricings Pricing[]
}

model Pricing {
  id          String   @id @default(cuid())
  variantId   String
  sugarTypeId String
  pricePerKg  Float
  effectiveDate DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  variant   SugarcaneVariant @relation(fields: [variantId], references: [id])
  sugarType SugarType        @relation(fields: [sugarTypeId], references: [id])

  @@unique([variantId, sugarTypeId])
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // DELIVERY, FARM
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  expenses Expense[]
  farmExpenses FarmExpense[]
}

model Expense {
  id         String   @id @default(cuid())
  quedanId   String
  userId     String
  categoryId String
  amount     Float
  receiptUrl String?
  notes      String?
  createdAt  DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  category ExpenseCategory  @relation(fields: [categoryId], references: [id])
}

model FarmExpense {
  id         String   @id @default(cuid())
  farmId     String
  categoryId String
  amount     Float
  receiptUrl String?
  notes      String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  farm     Farm             @relation(fields: [farmId], references: [id])
  category ExpenseCategory  @relation(fields: [categoryId], references: [id])
}

model Payment {
  id           String    @id @default(cuid())
  quedanId     String    @unique
  method       String    // BANK_TRANSFER, GCASH, CASH, CHECK
  referenceNumber String?
  grossAmount  Float
  deductions   Float     @default(0)
  netAmount    Float
  status       String    @default("PENDING") // PENDING, PARTIAL, PAID
  datePaid     DateTime?
  proofUrl     String?
  notes        String?
  createdAt    DateTime  @default(now())
}

model Farm {
  id          String   @id @default(cuid())
  farmName    String
  location    String
  barangay    String?
  hectares    Float?
  cropType    String?
  description String?
  isArchived  Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  owner   User           @relation("FarmerFarms", fields: [ownerId], references: [id])
  tickets WeightTicket[]
  farmExpenses FarmExpense[]
}

model WeightTicket {
  id             String    @id @default(cuid())
  ticketNo       String    @unique @default(cuid())
  truckPlate     String
  farmId         String
  grossWeight    Float
  tareWeight     Float
  millWeight     Float
  pricePerKg     Float     @default(2.50)
  totalValue     Float     @default(0)
  status         String    @default("PENDING") // PENDING, SUBMITTED, RECONCILED, DISPUTED
  notes          String?
  farmerId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())
  verifiedAt     DateTime?

  farm           Farm       @relation(fields: [farmId], references: [id])
  farmer         User       @relation("FarmerTickets", fields: [farmerId], references: [id])
  reconciliation ReconciliationRecord?
}

model ReconciliationRecord {
  id             String   @id @default(cuid())
  ticketId       String   @unique
  refineryWeight Float
  difference     Float
  percentDiff    Float
  flagged        Boolean  @default(false)
  notes          String?
  adminId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())
  reconciledAt   DateTime @default(now())
  resolvedAt     DateTime?

  ticket   WeightTicket @relation(fields: [ticketId], references: [id])
  admin    User         @relation("AdminReconciliations", fields: [adminId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetId   String?
  targetType String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  user User @relation("UserAudits", fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id                String   @id @default(cuid())
  varianceThreshold Float    @default(50)
  basePricePerKg    Float    @default(2.50)
  updatedAt         DateTime @updatedAt @default(now())
}
