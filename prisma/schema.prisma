// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  contactNumber      String?
  address            String?
  profilePicture     String?
  assignedMill       String?
  paNumber           String?  @unique
  millName           String?
  verificationStatus String   @default("UNVERIFIED")
  verificationDoc    String?
  verificationSelfie String?
  emailVerified      Boolean  @default(false)
  verificationCode   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @default(now())

  farms           Farm[]
  tickets         WeightTicket[]
  trucks          Truck[]
  expenses        Expense[]
}

model Bagon {
  id          String   @id @default(cuid())
  plateNumber String   @unique
  type        String   @default("18ft")
  tareWeight  Float?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  tickets WeightTicket[]
}

model Truck {
  id               String   @id @default(cuid())
  plateNumber      String   @unique
  driverName       String
  driverContact    String?
  compatibleTypes  String   @default("14ft,18ft,20ft")
  ownerId          String
  isArchived       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt @default(now())

  owner   User           @relation(fields: [ownerId], references: [id])
  tickets WeightTicket[]
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  expenses Expense[]
  farmExpenses FarmExpense[]
}

model Expense {
  id         String   @id @default(cuid())
  quedanId   String
  userId     String
  categoryId String
  amount     Float
  receiptUrl String?
  notes      String?
  createdAt  DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  category ExpenseCategory  @relation(fields: [categoryId], references: [id])
}

model FarmExpense {
  id         String   @id @default(cuid())
  farmId     String
  categoryId String
  amount     Float
  receiptUrl String?
  notes      String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  farm     Farm             @relation(fields: [farmId], references: [id])
  category ExpenseCategory  @relation(fields: [categoryId], references: [id])
}

model Payment {
  id           String    @id @default(cuid())
  quedanId     String    @unique
  quedan       WeightTicket @relation(fields: [quedanId], references: [id])
  method       String    // BANK_TRANSFER, GCASH, CASH, CHECK
  referenceNumber String?
  grossAmount  Float
  deductions   Float     @default(0)
  netAmount    Float
  status       String    @default("PENDING") // PENDING, PAID
  datePaid     DateTime?
  proofUrl     String?
  notes        String?
  createdAt    DateTime  @default(now())
}

model Farm {
  id          String   @id @default(cuid())
  farmName    String
  location    String
  barangay    String?
  hectares    Float?
  cropType    String?
  description String?
  isArchived  Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  owner   User           @relation(fields: [ownerId], references: [id])
  tickets WeightTicket[]
  farmExpenses FarmExpense[]
}

model DeliveryReceipt {
  id        String   @id @default(cuid())
  quedanId  String
  imageUrl  String
  createdAt DateTime @default(now())

  ticket WeightTicket @relation(fields: [quedanId], references: [id])
}

model WeightTicket {
  id               String    @id @default(cuid())
  ticketNo         String    @unique @default(cuid())
  bagonId          String
  truckId          String?
  farmId           String
  grossWeight      Float
  tareWeight       Float
  netWeight        Float     @default(0)
  brix             Float?
  pol              Float?
  purity           Float?
  sampleCollected  Boolean   @default(false)
  status           String    @default("PENDING") // PENDING, PAID
  notes            String?
  farmerId         String?
  truckNumber      String?
  caneVariety      String?
  loadRemarks      String?
  unloadingType    String?
  deliveryDate     DateTime?
  authorizedSignatory String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt @default(now())

  farm           Farm           @relation(fields: [farmId], references: [id])
  farmer         User?          @relation(fields: [farmerId], references: [id])
  bagon          Bagon?         @relation(fields: [bagonId], references: [id])
  truck          Truck?         @relation(fields: [truckId], references: [id])
  deliveryReceipts DeliveryReceipt[]
  payment        Payment?
}
